{
  "name": "archviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Software Architecture Visualizer — 100% browser-based",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:wasm": "cd packages/wasm-parser && wasm-pack build --target web --out-dir pkg",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
